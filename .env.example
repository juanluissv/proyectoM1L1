# Copy to .env and replace with your real values (never commit .env).

# --- Database (optional / future use) ---
DB_HOST=localhost
DB_PORT=5432

DB_USER=example_user
DB_PASSWORD=example_password_change_me
DB_NAME=example_database

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Second LLM provider (optional, for multi-provider triage) ---
# LLM_PROVIDER=openai
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Model call defaults (optional) ---
# OPENAI_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024
